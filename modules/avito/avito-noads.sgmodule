#!name=Avito NoAds & Deep Filter
#!desc=Блокировка рекламы + фильтр по словам, цене и категориям на Avito (iOS). Приоритет своего города.
#!category=AdBlock

#!arguments=слова:бпла|дрон|продам
#!arguments=цена:200000
#!arguments=категории:вакансии|работа
#!arguments=город:1

#!arguments-desc=слова:Стоп-слова для скрытия (разделитель |)
#!arguments-desc=цена:Макс. цена ₽ (0 = без лимита)
#!arguments-desc=категории:Где фильтровать (вакансии|резюме|работа|услуги|авто|недвижимость|электроника|все — пусто = только реклама)
#!arguments-desc=город:Приоритет своего города (1 = вкл, 0 = выкл)

[Script]
# Фильтрация ответов: реклама + kw/mp в выбранных категориях
Avito_AdBlock = type=http-response,pattern=^https?:\/\/app\.avito\.ru\/api\/.*(?:items|catalog|search|recommendations|widgets).*$,requires-body=1,max-size=524288,argument=kw:{{{слова}}};mp:{{{цена}}};cats:{{{категории}}},script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/avito/avito_cleaner.js

# Принудительный приоритет своего города в запросах
Avito_LocalPriority = type=http-request,pattern=^https?:\/\/app\.avito\.ru\/api\/.*(?:items|search|catalog|recommendations).*$,argument={{{город}}},script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/avito/avito_local.js

[Rule]
# Аналитика и трекеры
DOMAIN-SUFFIX,adriver.ru,REJECT
DOMAIN-SUFFIX,buzzoola.com,REJECT
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,mobile.yandex.net,REJECT
DOMAIN-SUFFIX,an.yandex.ru,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,stats.avito.ru,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,mytarget.com,REJECT

[URL Rewrite]
# Прямая блокировка рекламных баннеров
^https?:\/\/app\.avito\.ru\/api\/.*\/adv\/network\/banner - reject-200
^https?:\/\/app\.avito\.ru\/api\/.*\/items\/.*\/banners - reject-200

[MITM]
hostname = %APPEND% app.avito.ru, www.avito.ru, *.avito.ru

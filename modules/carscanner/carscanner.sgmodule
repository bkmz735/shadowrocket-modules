#!name=Car Scanner Pro Emulator
#!desc=Подмена статуса подписки на Pro для Car Scanner
#!category=Mod

[Script]
CarScanner_Pro = type=http-response,pattern=^https?:\/\/[^\/]*carscanner\.(info|cc)\/.*,requires-body=1,max-size=524288,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/carscanner/carscanner_pro.js

[Rule]
# Сюда можно добавить правила для блокировки рекламы или телеметрии, если нужно

[MITM]
hostname = %APPEND% carscanner.info, carscanner.cc, uc.r.appspot.com
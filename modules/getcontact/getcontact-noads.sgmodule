#!name=GetContact AdBlock (DNS + API Patch)
#!desc=Полная блокировка рекламы в GetContact. Сочетает отключение инициализации SDK (через JSON-патч) и блокировку рекламных доменов.
#!category=AdBlock

[Script]
# Патчим открытую брешь: отключаем инициализацию рекламных движков (AdMob, AppLovin, Yandex) на старте
GetContact_SDK_Blocker = type=http-response,pattern=^https?:\/\/(?:api|premium)\.getcontact\.com\/v.*\/event-enabled,requires-body=1,max-size=524288,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/getcontact/getcontact_cleaner.js

[Rule]
# Блокировка аналитики самого GetContact
DOMAIN-SUFFIX,analytics.getcontact.com,REJECT
DOMAIN-KEYWORD,getcontact-analytics,REJECT

# Популярные рекламные сети и трекеры, встроенные в GetContact
DOMAIN-SUFFIX,applovin.com,REJECT
DOMAIN-SUFFIX,applvn.com,REJECT
DOMAIN-SUFFIX,appsflyer.com,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,pubmatic.com,REJECT
DOMAIN-SUFFIX,criteo.com,REJECT
DOMAIN-SUFFIX,criteo.net,REJECT
DOMAIN-SUFFIX,inmobi.com,REJECT
DOMAIN-SUFFIX,smaato.net,REJECT
DOMAIN-SUFFIX,rubiconproject.com,REJECT
DOMAIN-SUFFIX,ads.mopub.com,REJECT
DOMAIN-SUFFIX,vungle.com,REJECT
DOMAIN-SUFFIX,chartboost.com,REJECT

[MITM]
# Перехват только для подмены конфигурации SDK
hostname = %APPEND% api.getcontact.com, premium.getcontact.com

#!url=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/location-spoofer/location-spoofer.sgmodule
﻿#!name=iOS Location Spoofer
#!desc=Перехватывает и подменяет системные координаты Apple Location Services (/clls/wloc). Можно выбрать город из списка или ввести свои координаты.
#!category=Location
#!system=ios
#!arguments=город:москва,широта:55.7558,долгота:37.6173
#!arguments-desc=город: Название города (москва, питер, спб, киев, минск, алматы, астана, тбилиси, ереван, дубай, лондон, токио, купертино, вручную)\nширота: Широта точки (используется если город указан как 'вручную', например 55.7558)\nдолгота: Долгота точки (используется если город указан как 'вручную', например 37.6173)

[Script]
iOS Location Spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/location-spoofer/location-spoofer.js,argument={город}&{широта}&{долгота}&mode=response

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com

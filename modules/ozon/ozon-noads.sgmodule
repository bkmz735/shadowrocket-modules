#!name=Ozon NoAds & Clean Layout
#!desc=Блокировка рекламы, видео-баннеров, модалок, промо Ozon Банка (карты/кредиты), спам-уведомлений и трекеров.
#!category=AdBlock

[Rule]
# Внешние трекеры, аналитика и рекламные сети
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,mobile.yandex.net,REJECT
DOMAIN-SUFFIX,an.yandex.ru,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,mytarget.com,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,top-fwz1.mail.ru,REJECT
DOMAIN-SUFFIX,tns-counter.ru,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,weborama-tech.ru,REJECT
DOMAIN-SUFFIX,serving-sys.ru,REJECT
DOMAIN-SUFFIX,litix.io,REJECT

# Внутренние трекеры кликов/показов Ozon и аналитика Ozon Банка
DOMAIN,p.ozon.ru,REJECT
DOMAIN,sentry.ozon.ru,REJECT
DOMAIN,io-bank.ozone.ru,REJECT
URL-REGEX,^https?:\/\/api\.ozon\.ru\/p-api\/tracker\/,REJECT
URL-REGEX,^https?:\/\/api\.ozon\.ru\/p-api\/perf-metrics-collector\/,REJECT

# Подавление всплывающих модалок, промо-пушей и экшенов показа баннеров
URL-REGEX,^https?:\/\/api\.ozon\.ru\/api\/composer-api\.bx\/_action\/v2\/setBannerAction,REJECT
URL-REGEX,^https?:\/\/api\.ozon\.ru\/api\/composer-api\.bx\/_action\/inAppPushAction,REJECT
URL-REGEX,^https?:\/\/api\.ozon\.ru\/api\/composer-api\.bx\/page\/json\/v2\?url=\/modal\/alert\/,REJECT

[Script]
# Вырезка рекламы, баннеров и спам-каналов в чатах/сообщениях
ozon-cleaner = type=http-response,pattern=^https?:\/\/api\.ozon\.ru\/.*(page\/json|messenger|chat|communication).*$,requires-body=1,max-size=5242880,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/ozon/ozon_cleaner.js,timeout=15

[MITM]
hostname = %APPEND% api.ozon.ru
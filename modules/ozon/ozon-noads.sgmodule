#!name=Ozon NoAds & Clean Layout
#!desc=Блокировка рекламы, трекеров, аналитики и промо-баннеров в приложении Ozon.
#!category=AdBlock

[Rule]
# Аналитика, метрики и трекеры
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,mobile.yandex.net,REJECT
DOMAIN-SUFFIX,an.yandex.ru,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,mytarget.com,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,tns-counter.ru,REJECT
DOMAIN-SUFFIX,top-fwz1.mail.ru,REJECT

# Внутренние рекламные и аналитические эндпоинты Ozon
DOMAIN,metrics.ozon.ru,REJECT
DOMAIN,tracker.ozon.ru,REJECT
DOMAIN,analytics.ozon.ru,REJECT

[Script]
# Очистка рекламных блоков и промо-виджетов в API
ozon-cleaner = type=http-response,pattern=^https?:\/\/(api|xapi|xapi-gate|api-mobile)\.ozon\.ru\/.*$,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/ozon/ozon_cleaner.js,timeout=10

[MITM]
hostname = %APPEND% api.ozon.ru, xapi.ozon.ru, xapi-gate.ozon.ru, api-mobile.ozon.ru
#!name=Ozon Promo & Coupon Sniffer
#!desc=Автоматический поиск и логирование ключей промо-баннеров, купонов, розыгрышей и акций Ozon.
#!category=Sniffer

[Script]
ozon-promo-sniffer = type=http-response,pattern=^https?:\/\/api\.ozon\.ru\/.*$,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/ozon/ozon_sniffer.js?v=2.0,timeout=15

[MITM]
hostname = %APPEND% api.ozon.ru
#!name=Universal Ad & Spam Cleaner
#!desc=Безопасный универсальный модуль фильтрации рекламы, спама и баннеров из ответов приложений на iOS через Shadowrocket. Оптимизирован против вылетов VPN.
#!category=AdBlock

#!arguments=keywords:реклама|промо|banner|sponsored|myTarget|yandex
#!arguments-desc=keywords:список ключевых слов через | для вырезания блоков рекламы из JSON

[Script]
# max-size=524288 (512KB) для защиты памяти NetworkExtension от переполнения
Universal_Cleaner = type=http-response,pattern=^https?:\/\/(?!.*(?:\.png|\.jpg|\.jpeg|\.gif|\.webp|\.mp4|\.m3u8|\.ts|\.css|\.woff2|\.zip)).*,requires-body=1,max-size=524288,argument={{{keywords}}},script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/sniffer/universal_cleaner.js

[Rule]
# Известные трекеры и рекламные сети
DOMAIN-SUFFIX,adriver.ru,REJECT
DOMAIN-SUFFIX,buzzoola.com,REJECT
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,mobile.yandex.net,REJECT
DOMAIN-SUFFIX,an.yandex.ru,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.net.in,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,uxfeedback.ru,REJECT
DOMAIN-SUFFIX,mytarget.com,REJECT
DOMAIN-SUFFIX,target.my.com,REJECT

[MITM]
# Исключаем системные домены Apple и стримы для стабильности VPN
hostname = %APPEND% -*.apple.com, -*.icloud.com, -*.push.apple.com, -*.cdn-apple.com, -*.mzstatic.com, -*.gvt1.com, -*.googlevideo.com, *

#!name=Universal Ad & Spam Cleaner
#!desc=Универсальный модуль фильтрации рекламы и баннеров из ответов приложений на iOS через Shadowrocket.
#!category=AdBlock

#!arguments=keywords:реклама|промо|banner|sponsored|myTarget|yandex
#!arguments-desc=keywords:список ключевых слов через | для вырезания блоков рекламы из JSON

[Script]
Universal_Cleaner = type=http-response,pattern=^https?:\/\/(?!.*(?:\.png|\.jpg|\.jpeg|\.gif|\.webp|\.mp4|\.m3u8|\.ts|\.css|\.woff2|\.zip|longpoll|\/im|\/push)).*,requires-body=1,max-size=524288,argument={{{keywords}}},script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/sniffer/universal_cleaner.js

[Rule]
DOMAIN,sdk.mail.ru,REJECT
DOMAIN,rv.mail.ru,REJECT
DOMAIN,eh.vk.com,REJECT
DOMAIN,trace-flow.ru,REJECT
DOMAIN-SUFFIX,adriver.ru,REJECT
DOMAIN-SUFFIX,buzzoola.com,REJECT
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,mobile.yandex.net,REJECT
DOMAIN-SUFFIX,an.yandex.ru,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.net.in,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,uxfeedback.ru,REJECT
DOMAIN-SUFFIX,mytarget.com,REJECT
DOMAIN-SUFFIX,target.my.com,REJECT

[MITM]
hostname = %APPEND% -*.apple.com, -*.icloud.com, -*.push.apple.com, -*.cdn-apple.com, -*.mzstatic.com, -*.gvt1.com, -*.googlevideo.com, -lp.vk.com, -queue.vk.com, -queuev4.vk.ru, -im.vk.com, -eh.vk.com, -persiq.vk.com, -*.userapi.com, -*.vkuserphoto.ru, -*.vkuseraudio.net, -*.mycdn.me, *

#!name=Universal Traffic Inspector & Sniffer
#!desc=Универсальный сниффер трафика для Shadowrocket (iOS). Перехватывает HTTP/HTTPS ответы API, выводит структуру в лог. Безопасен для VK, Telegram и системных сервисов.
#!category=Sniffer

[Script]
Universal_Sniffer = type=http-response,pattern=^https?:\/\/(?!.*(?:\.png|\.jpg|\.jpeg|\.gif|\.webp|\.mp4|\.m3u8|\.ts|\.css|\.woff2|\.zip|longpoll|\/im|\/push)).*,requires-body=1,max-size=524288,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/sniffer/universal_sniffer.js

[MITM]
# Исключения ОБЯЗАТЕЛЬНО должны идти ПЕРЕД *, иначе Shadowrocket их проигнорирует!
hostname = %APPEND% -internal.api.vk.ru, -eh.vk.com, -persiq.vk.com, -lp.vk.com, -queue.vk.com, -queuev4.vk.ru, -im.vk.com, -*.userapi.com, -*.vkuserphoto.ru, -*.vkuseraudio.net, -*.mycdn.me, -*.apple.com, -*.icloud.com, -*.push.apple.com, -*.cdn-apple.com, -*.mzstatic.com, -*.gvt1.com, -*.googlevideo.com, *

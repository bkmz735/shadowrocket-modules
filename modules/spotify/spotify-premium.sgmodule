#!name=Spotify Premium
#!desc=Разблокировка функций Spotify Premium, блокировка рекламы и фикс сброса сессий/треков. Трафик направляется через PROXY.
#!category=Spotify

[Rule]
# Блокировка рекламы и логов (без затрагивания аудио-потоков и CDN)
DOMAIN,crashdump.spotify.com,REJECT
DOMAIN,log.spotify.com,REJECT
DOMAIN,adlogic.spotify.com,REJECT
DOMAIN-SUFFIX,scorecardresearch.com,REJECT
URL-REGEX,^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(ad-logic|ads|podcast-ap4p\/.*\/ads|partner-userid|gabo-receiver-service|vanilla\/.*\/recommendations-in-free-tier-playlist)\/,REJECT

# Полный список аудио-CDN и доменов Spotify направляется через PROXY
DOMAIN-KEYWORD,spotify,PROXY
DOMAIN-SUFFIX,scdn.co,PROXY
DOMAIN-SUFFIX,pscdn.co,PROXY
DOMAIN-SUFFIX,spoti.fi,PROXY
DOMAIN-SUFFIX,spotifycdn.com,PROXY
DOMAIN-SUFFIX,spotifycdn.net,PROXY
DOMAIN-SUFFIX,akamaized.net,PROXY

[Header Rewrite]
^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/user-customization-service\/v1\/customize header-del If-None-Match

[Script]
spotify-json = type=http-request,pattern=^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify-json.js,timeout=10
spotify-proto = type=http-response,pattern=^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify-proto.js,timeout=10

[MITM]
# Строго изолированный MITM только для кастомизации подписки (без login5, apresolve и spotifycdn)
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com

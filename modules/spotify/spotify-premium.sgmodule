#!name=Spotify Premium
#!desc=Разблокировка функций Spotify Premium, блокировка рекламы и гибридная маршрутизация (API через PROXY, аудио-потоки напрямую через DIRECT).
#!category=Spotify

[Rule]
# 1. Блокировка рекламы, аналитики и промо-баннеров
DOMAIN,crashdump.spotify.com,REJECT
DOMAIN,log.spotify.com,REJECT
DOMAIN,adlogic.spotify.com,REJECT
DOMAIN-SUFFIX,scorecardresearch.com,REJECT
URL-REGEX,^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(ad-logic|ads|podcast-ap4p\/.*\/ads|partner-userid|gabo-receiver-service|vanilla|pendragon|trials-facade|sponsoredplaylist)\/,REJECT

# 2. Аудио-потоки, CDN и WebSocket Dealer -> DIRECT (максимальная скорость, защита от обрывов на 8-10 сек)
DOMAIN,gew1-dealer.g2.spotify.com,DIRECT
DOMAIN-SUFFIX,dealer.spotify.com,DIRECT
DOMAIN-SUFFIX,scdn.co,DIRECT
DOMAIN-SUFFIX,pscdn.co,DIRECT
DOMAIN-SUFFIX,spotifycdn.com,DIRECT
DOMAIN-SUFFIX,spotifycdn.net,DIRECT
DOMAIN-SUFFIX,akamaized.net,DIRECT

# 3. Авторизация, сессия и API шлюзы -> PROXY (соответствие региону аккаунта)
DOMAIN,login5.spotify.com,PROXY
DOMAIN,apresolve.spotify.com,PROXY
DOMAIN-KEYWORD,spclient,PROXY
DOMAIN-KEYWORD,spotify,PROXY

[Header Rewrite]
^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/.* header-del If-None-Match
^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/.* header-del If-Modified-Since

[Script]
spotify-json = type=http-request,pattern=^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify-json.js?v=20260903_02,timeout=10
spotify-proto = type=http-response,pattern=^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify-proto.js?v=20260903_02,timeout=10

[MITM]
# Строго изолированный MITM только для кастомизации подписки (без login5, apresolve и spotifycdn)
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com

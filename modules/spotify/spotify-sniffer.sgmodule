#!name=Spotify Traffic Sniffer
#!desc=Глубокий анализ всех запросов, ответов, чанков аудио, лицензий и сессий Spotify для диагностики и реверс-инжиниринга.
#!category=Sniffer

[Rule]
# Направляем весь трафик Spotify напрямую или в прокси (настроено DIRECT для чистого теста)
DOMAIN-KEYWORD,spotify,DIRECT
DOMAIN-SUFFIX,scdn.co,DIRECT
DOMAIN-SUFFIX,pscdn.co,DIRECT
DOMAIN-SUFFIX,spoti.fi,DIRECT
DOMAIN-SUFFIX,spotifycdn.com,DIRECT
DOMAIN-SUFFIX,spotifycdn.net,DIRECT
DOMAIN-SUFFIX,akamaized.net,DIRECT

[Script]
# Сниффер запросов (Request)
Spotify_Req_Sniffer = type=http-request,pattern=^https?:\/\/.*(spotify|scdn|spotifycdn|akamaized).*$,requires-body=1,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify_sniffer.js,timeout=30

# Сниффер ответов (Response)
Spotify_Res_Sniffer = type=http-response,pattern=^https?:\/\/.*(spotify|scdn|spotifycdn|akamaized).*$,requires-body=1,max-size=2097152,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify_sniffer.js,timeout=30

[MITM]
hostname = %APPEND% *.spotify.com, *.wg.spotify.com, *-spclient.spotify.com, *.scdn.co, *.pscdn.co, *.spotifycdn.com, *.spotifycdn.net, *.akamaized.net

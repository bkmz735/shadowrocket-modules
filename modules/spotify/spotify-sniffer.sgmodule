#!name=Spotify Traffic Sniffer
#!desc=Глубокий анализ всех запросов и ответов Spotify без перегрузки памяти с нормализацией URL (срез :443). Трафик через PROXY.
#!category=Sniffer

[Rule]
# Направляем весь трафик Spotify через PROXY
DOMAIN-KEYWORD,spotify,PROXY
DOMAIN-SUFFIX,scdn.co,PROXY
DOMAIN-SUFFIX,pscdn.co,PROXY
DOMAIN-SUFFIX,spoti.fi,PROXY
DOMAIN-SUFFIX,spotifycdn.com,PROXY
DOMAIN-SUFFIX,spotifycdn.net,PROXY
DOMAIN-SUFFIX,akamaized.net,PROXY

[Header Rewrite]
# Удаление заголовков кэширования для получения полных ответов от серверов Spotify
^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/.* header-del If-None-Match
^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/.* header-del If-Modified-Since

[Script]
# Сниффер запросов: срезает :443, удаляет кэш и логирует параметры (исключен extended-metadata во избежание OOM)
Spotify_Req_Sniffer = type=http-request,pattern=^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(user-customization|bootstrap|device-capabilities|capping-api|social-connect|connect-state|connect-group|color-lyrics|scrollsita|casita|browsita|artistview|album-entity|ad-logic|ads|remote-config-resolver|storage-resolve|playplay|pam-view-service|net-fortune|image-resolve|herodotus|offline|pushka-tokens|speechless|partner-userid|partner-client-integrations|gander|contribution|inspiredby-mix|premium-destination-hubs|sessiontransfer),requires-body=0,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify_sniffer.js,timeout=10

# Сниффер ответов: логирует статусы, размер и тип ответа без накопления тяжелых буферов
Spotify_Res_Sniffer = type=http-response,pattern=^https?:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(user-customization|bootstrap|device-capabilities|capping-api|social-connect|connect-state|connect-group|color-lyrics|scrollsita|casita|browsita|artistview|album-entity|ad-logic|ads|remote-config-resolver|storage-resolve|playplay|pam-view-service|net-fortune|image-resolve|herodotus|offline|pushka-tokens|speechless|partner-userid|partner-client-integrations|gander|contribution|inspiredby-mix|premium-destination-hubs|sessiontransfer),requires-body=0,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/spotify/spotify_sniffer.js,timeout=10

[MITM]
# Исключаем login5, apresolve и CDN из MITM, чтобы не ломать SSL Pinning
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com, -login5.spotify.com, -*.spotifycdn.com, -*.scdn.co, -apresolve.spotify.com

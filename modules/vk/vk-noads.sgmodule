#!name=VK NoAds & Clean Feed
#!desc=Полная блокировка рекламы, промо-постов, баннеров и трекеров в VK (ВКонтакте) на iOS через Shadowrocket. Поддержка api.vk.ru и api.vk.com.
#!category=AdBlock

[Script]
# Перехватываем все методы API VK на api.vk.ru, api.vk.com, api.vk.me и internal.api.vk.ru
VK_Cleaner = type=http-response,pattern=^https?:\/\/(?:api\.vk\.(?:com|me|ru)|internal\.api\.vk\.ru)\/method\/.*,requires-body=1,max-size=524288,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/vk/vk_cleaner.js

[Rule]
# Блокировка рекламных доменов, баннерных сетей и трекеров
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,apptracer.ru,REJECT
DOMAIN-SUFFIX,ads.vk.com,REJECT
DOMAIN-SUFFIX,mytarget.com,REJECT
DOMAIN-SUFFIX,target.my.com,REJECT
DOMAIN,sdk.mail.ru,REJECT
DOMAIN,rv.mail.ru,REJECT
DOMAIN,clientapi.mail.ru,REJECT
DOMAIN,ad.mail.ru,REJECT
DOMAIN,r.mradx.net,REJECT
DOMAIN,trace-flow.ru,REJECT

[URL Rewrite]
^https?:\/\/api\.vk\.(?:com|me|ru)\/method\/ads\..* - reject-200
^https?:\/\/api\.vk\.(?:com|me|ru)\/method\/promotedPost\..* - reject-200

[MITM]
# Перехватываем API домены VK, включая api.vk.ru
hostname = %APPEND% api.vk.com, api.vk.me, api.vk.ru, internal.api.vk.ru, *.vk.com, *.vk.ru, -eh.vk.com, -persiq.vk.com, -lp.vk.com, -queue.vk.com, -queuev4.vk.ru, -im.vk.com, -*.userapi.com, -*.vkuserphoto.ru, -*.vkuseraudio.net, -*.mycdn.me

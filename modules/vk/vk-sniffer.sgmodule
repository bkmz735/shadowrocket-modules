#!name=VK Traffic Inspector & Sniffer
#!desc=Специализированный сниффер трафика ВКонтакте (VK iOS). Работает стабильно: перехватывает только нужные API, не трогая системные домены и сокеты.
#!category=Sniffer

[Script]
VK_Sniffer = type=http-response,pattern=^https?:\/\/(?:api\.vk\.(?:com|me|ru))\/method\/.*,requires-body=1,max-size=524288,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/vk/vk_sniffer.js

[MITM]
# СТРОГО: Перехватываем только 3 конкретных домена API. Никаких *.vk.com, чтобы не сломать системные пинги и сокеты!
hostname = %APPEND% api.vk.com, api.vk.me, api.vk.ru

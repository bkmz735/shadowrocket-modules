#!name=VK Traffic Inspector & Sniffer
#!desc=Специализированный сниффер трафика ВКонтакте (VK iOS). Безопасно анализирует методы API VK (лента, рекомендации, видео), исключая пинги сети, чаты и медиа-потоки.
#!category=Sniffer

[Script]
VK_Sniffer = type=http-response,pattern=^https?:\/\/(?:api\.vk\.com|api\.vk\.me)\/method\/(?!im|longpoll|push).*requires-body=1,max-size=524288,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/vk/vk_sniffer.js

[MITM]
hostname = %APPEND% api.vk.com, api.vk.me, *.vk.com, -internal.api.vk.ru, -eh.vk.com, -persiq.vk.com, -lp.vk.com, -queue.vk.com, -queuev4.vk.ru, -im.vk.com, -*.userapi.com, -*.vkuserphoto.ru, -*.vkuseraudio.net, -*.mycdn.me

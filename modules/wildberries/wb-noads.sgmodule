#!name=Wildberries NoAds (Fast & Stable)
#!desc=Блокировка рекламы, промо-баннеров и телеметрии Wildberries без перегрузки VPN.
#!category=AdBlock

[Rule]
# 1. Жесткая отсечка фонового спама телеметрии WB (устраняет перегрузку)
DOMAIN,journal-bt.wildberries.ru,REJECT
DOMAIN,a.wb.ru,REJECT
DOMAIN,marketplace-sentry.wb.ru,REJECT
DOMAIN,xapi.wildberries.ru,REJECT

# 2. Внешняя реклама и трекеры
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,app-ads-services.com,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,firebase-settings.crashlytics.com,REJECT
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com,REJECT
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,top-fwz1.mail.ru,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,tns-counter.ru,REJECT

[Script]
# Точечный перехват только конфига и баннеров (без тяжелых каталогов)
wb-cleaner = type=http-response,pattern=^https?:\/\/.*(apps-config\.wildberries\.ru\/config\/api\/v2\/(reactive|config)|banners-bt\.wildberries\.ru\/api\/|chances\.wildberries\.ru).*$,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/wildberries/wb_cleaner.js,timeout=10

[MITM]
hostname = %APPEND% apps-config.wildberries.ru, banners-bt.wildberries.ru, chances.wildberries.ru

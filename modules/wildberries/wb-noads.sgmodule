#!name=Wildberries NoAds & Clean Layout
#!desc=Блокировка рекламы, промо-баннеров, авторекламы в поиске и телеметрии в приложении Wildberries на iOS.
#!category=AdBlock

[Rule]
# Внутренняя телеметрия, журнал кликов и трекинг Wildberries
DOMAIN,journal-bt.wildberries.ru,REJECT
DOMAIN,a.wb.ru,REJECT
DOMAIN,marketplace-sentry.wb.ru,REJECT
URL-REGEX,^https?:\/\/xapi\.wildberries\.ru\/stat\/api\/,REJECT

# Сервисы баннеров и промо-акций
DOMAIN,banners-bt.wildberries.ru,REJECT
DOMAIN,banners.wb.ru,REJECT

# Внешние рекламные сети, трекеры и аналитика
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,app-ads-services.com,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,firebase-settings.crashlytics.com,REJECT
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com,REJECT
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,top-fwz1.mail.ru,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,tns-counter.ru,REJECT

[Script]
# Очистка конфигурации флагов (баннеры, карусели) и выдачи товаров (бустеры/рекламные товары)
wb-cleaner = type=http-response,pattern=^https?:\/\/.*(apps-config\.wildberries\.ru\/config\/api\/v2\/(reactive|config)|catalog\.wb\.ru|napi\.wildberries\.ru|user-cards\.wb\.ru).*$,requires-body=1,max-size=5242880,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/wildberries/wb_cleaner.js,timeout=15

[MITM]
hostname = %APPEND% apps-config.wildberries.ru, napi.wildberries.ru, catalog.wb.ru, user-cards.wb.ru

#!name=Wildberries DNS Blocker (Pure & 100% Stable)
#!desc=Абсолютно стабильная блокировка рекламы и спама телеметрии WB на уровне DNS/TCP без MITM и без скриптов (VPN не вылетает).
#!category=AdBlock

[Rule]
# 1. Подавление шквала фоновой телеметрии WB (главная причина падений VPN)
DOMAIN,journal-bt.wildberries.ru,REJECT
DOMAIN,a.wb.ru,REJECT
DOMAIN,marketplace-sentry.wb.ru,REJECT
DOMAIN,xapi.wildberries.ru,REJECT

# 2. Сервисы баннеров, акций и лотерей WB
DOMAIN,banners-bt.wildberries.ru,REJECT
DOMAIN,banners.wb.ru,REJECT
DOMAIN,chances.wildberries.ru,REJECT

# 3. Внешние трекеры и рекламные сети
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,app-ads-services.com,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,firebase-settings.crashlytics.com,REJECT
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com,REJECT
DOMAIN-SUFFIX,appmetrica.yandex.net,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,adjust.world,REJECT
DOMAIN-SUFFIX,top-fwz1.mail.ru,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,tns-counter.ru,REJECT

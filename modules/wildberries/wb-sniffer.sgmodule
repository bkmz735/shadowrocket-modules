#!name=Wildberries Sniffer (Ultra Light)
#!desc=Сниффер только баннеров и главной страницы WB без перегрузки памяти iOS.
#!category=Sniffer

[Script]
wb-light-sniffer = type=http-response,pattern=^https?:\/\/.*(banners-bt\.wildberries\.ru|home-service\.wildberries\.ru\/home-service\/api\/v1\/home).*$,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/wildberries/wb_sniffer.js,timeout=10

[MITM]
hostname = %APPEND% banners-bt.wildberries.ru, home-service.wildberries.ru

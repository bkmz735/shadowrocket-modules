#!name=Wildberries Deep Sniffer & Inspector
#!desc=Глубокий перехват и инспекция сетевых запросов Wildberries с извлечением текста рекламы, баннеров, акций и каруселей.
#!category=Sniffer

[Script]
wb-deep-sniffer = type=http-response,pattern=^https?:\/\/.*(wildberries|wb|wbbasket)\.ru\/.*$,requires-body=1,max-size=10485760,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/wildberries/wb_sniffer.js,timeout=30

[MITM]
hostname = %APPEND% *.wildberries.ru, *.wb.ru, *.wbbasket.ru, home-service.wildberries.ru, napi.wildberries.ru, catalog.wb.ru, user-features.wb.ru, marketing-info.wildberries.ru, splitter.wb.ru, banners-bt.wildberries.ru

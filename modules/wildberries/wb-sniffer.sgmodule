#!name=Wildberries Target Finder
#!desc=Точечный перехватчик рекламы по ключевым словам ("Миксит", "Шейд", "Здесь все", "Реклама").
#!category=Sniffer

[Rule]
# Сброс шумной телеметрии (VPN не падает)
DOMAIN,journal-bt.wildberries.ru,REJECT
DOMAIN,a.wb.ru,REJECT
DOMAIN,marketplace-sentry.wb.ru,REJECT
DOMAIN,xapi.wildberries.ru,REJECT
DOMAIN,statistics-bt.wildberries.ru,REJECT

[Script]
wb-finder = type=http-response,pattern=^https?:\/\/.*(wildberries|wb|wbbasket)\.ru\/.*$,requires-body=1,max-size=5242880,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/wildberries/wb_sniffer.js?v=finder1,timeout=15

[MITM]
hostname = %APPEND% *.wildberries.ru, *.wb.ru, ui-bt.wildberries.ru, banners-bt.wildberries.ru, api-ios.wildberries.ru, home-service.wildberries.ru, chances.wildberries.ru

#!name=Wildberries Sniffer (UI, Profile & Bank)
#!desc=Точечный сниффер баннеров, личного кабинета (ЛК), WB Банка и лотерей без перегрузки VPN.
#!category=Sniffer

[Script]
wb-ui-sniffer = type=http-response,pattern=^https?:\/\/.*(banners-bt\.wildberries\.ru|ui-bt\.wildberries\.ru\/ui-bt\/api\/v1\/profile|wb-balance\.wildberries\.ru|installments-aggregator-bt\.wildberries\.ru|chances\.wildberries\.ru|home-service\.wildberries\.ru\/home-service\/api\/v1\/home).*$,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/bkmz735/shadowrocket-modules/main/modules/wildberries/wb_sniffer.js,timeout=10

[MITM]
hostname = %APPEND% banners-bt.wildberries.ru, ui-bt.wildberries.ru, wb-balance.wildberries.ru, installments-aggregator-bt.wildberries.ru, chances.wildberries.ru, home-service.wildberries.ru
